*.asc
*.gpg
*.rev
*.pem
__pycache__/
*.pyc

# generated site and the generated Android project (recreated by `tauri android init` + scripts/android_patch_manifest.py)
site-dist/
src-tauri/gen/android/
release-files/
# leftovers of a local run of the CI packaging steps (CI creates them in its own throw-away workspace)
pkg/
aligned.apk
*.apk.idsig
