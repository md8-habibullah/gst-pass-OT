# Arch Linux package for Hexis: builds the committed source of this repository (it is meant to be run from
# packaging/arch/ inside a clone: `makepkg -si`). Tauri has no pacman bundler, so this compiles the binary itself.
# Replace the maintainer line and, for an AUR upload, switch `source` to the release tarball and fill in its checksum.
# Maintainer: you <you@example.com>
pkgname=hexis
pkgver=0.5.0
pkgrel=1
pkgdesc='Post-quantum zero-knowledge password vault with multi-S3 sync (works offline)'
arch=('x86_64')
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'openssl')
makedepends=('rust' 'cargo' 'nodejs' 'npm' 'git' 'librsvg')
options=('!lto')
# No download: the sources come from the clone this file sits in (committed files only, so the build is reproducible).
source=()
sha256sums=()

prepare() {
  local repo="$startdir/../.."
  mkdir -p "$srcdir/$pkgname"
  git -C "$repo" archive --prefix="$pkgname/" HEAD | tar -x -C "$srcdir"
  # The package version must be the version the app reports.
  local appver
  appver=$(sed -n 's/^  "version": "\(.*\)",/\1/p' "$srcdir/$pkgname/src-tauri/tauri.conf.json" | head -n1)
  [ "$appver" = "$pkgver" ] || { echo "pkgver ($pkgver) does not match tauri.conf.json ($appver)" >&2; return 1; }
}

build() {
  cd "$srcdir/$pkgname"
  npm ci
  npm run tauri build -- --no-bundle
}

package() {
  cd "$srcdir/$pkgname"
  install -Dm755 src-tauri/target/release/hexis "$pkgdir/usr/bin/hexis"
  install -Dm644 packaging/hexis.desktop "$pkgdir/usr/share/applications/hexis.desktop"
  install -Dm644 src-tauri/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/hexis.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
